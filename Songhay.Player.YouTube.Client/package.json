{
    "name": "songhay-player-yt-client",
    "version": "1.0.0",
    "description": "the b-roll player for YouTube™ curated lists",
    "main": "_index.js",
    "scripts": {
        "build": "tsc",
        "index:sass": "npx sass ./src/scss/_index.scss ./wwwroot/css/index.min.css --load-path=./node_modules --no-source-map --style=compressed",
        "version:patch": "npm version patch -m \":rocket: :snowflake: version patch up to %s\"",
        "webpack:bundle": "npx webpack --config-name=default-config --mode=production",
        "webpack:bundle-opt": "npx webpack --config-name=optimization-config --mode=production"
    },
    "author": "Bryan D. Wilhite",
    "license": "MIT",
    "dependencies": {
        "bulma": "^1.0.4",
        "songhay": "^0.3.6"
    },
    "devDependencies": {
        "@types/blazor__javascript-interop": "^3.1.3",
        "clean-webpack-plugin": "^4.0.0",
        "sass": "^1.101.0",
        "terser-webpack-plugin": "^5.6.1",
        "ts-loader": "^9.4.3",
        "tslib": "^2.5.3",
        "typescript": "^7.0.2",
        "webpack": "^5.86.0",
        "webpack-cli": "^7.2.2"
    }
}
