{
    "RestApiMetadata": {
        "PlayerApi": {
            "ApiBase": "https://video-yt.brollplayer.com/",
            "ClaimsSet": {
                "prefix-for-yt-channel-root": "https://www.youtube.com/channel/",
                "prefix-for-yt-watch-root": "https://www.youtube.com/watch?v=",
                "route-for-video-yt-manifest": "youtube-channels/{id}.json",
                "route-for-video-yt-index": "{indexKey}.json",
                "route-for-video-yt-playlist": "youtube-uploads/{subFolder}/{blobName}.json",
                "route-for-video-yt-playlist-set": "youtube-uploadsets/{setKey}/{id}.json",
                "route-for-video-yt-curated-manifest": "{presentationKey}/{presentationKey}_presentation.json"
            }
        }
    }
}
